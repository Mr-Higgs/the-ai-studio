{
  "buildCommand": "npm run build",
  "outputDirectory": "ui/dist",
  "rewrites": [
    {
      "source": "/guide",
      "destination": "/guide.html"
    },
    {
      "source": "/intake",
      "destination": "/intake.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": ".devin/skills/**"
    }
  }
}
