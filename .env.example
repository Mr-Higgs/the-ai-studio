HEYGEN_API_KEY=your_api_key_here
# Optional: HeyGen OAuth — set a pre-registered client id to skip dynamic registration,
# and/or send a resource indicator (none by default; HeyGen rejects https://api.heygen.com).
# HEYGEN_OAUTH_CLIENT_ID=
# HEYGEN_OAUTH_RESOURCE=
# Optional: canonical https origin for the HeyGen OAuth callback on non-localhost hosts.
# PUBLIC_ORIGIN=
# Optional: Google Business Profile OAuth — until both are set the Setup row shows "coming soon".
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=your_api_key_here
# Optional: shared Devin account (runs in your org, on your credits). Only the Supabase user IDs
# listed in DEVIN_SHARED_USER_IDS (comma-separated) may use it; everyone else saves their own key.
# DEVIN_API_KEY=
# DEVIN_ORG_ID=
# DEVIN_SHARED_USER_IDS=
